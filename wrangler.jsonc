{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "faithcraft-agency",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "faithcraft.agency",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}

